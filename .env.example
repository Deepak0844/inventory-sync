# URL-safe characters only (letters, digits, - _): it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Enables a short-lived visible browser for login/CAPTCHA completion.
# On a VPS, keep port 6080 bound to loopback and reach it through an SSH tunnel.
MANUAL_BROWSER_ENABLED=false
MANUAL_BROWSER_PASSWORD=
# MANUAL_BROWSER_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
# Where Test run screenshots are kept (the compose file mounts a shared volume at /srv/data).
# DATA_DIR=data
